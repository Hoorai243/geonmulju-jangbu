{
  "name": "geonmulju-jangbu",
  "version": "1.29.3",
  "description": "건물주 장부 — 월세·관리비·보증금 관리 PWA (정적 파일, 빌드 불필요)",
  "type": "module",
  "private": true,
  "scripts": {
    "icons": "node icons/generate-icons.mjs",
    "start": "node scripts/dev-server.mjs",
    "build:www": "node scripts/build-www.mjs",
    "sync": "npm run build:www && npx cap sync android && node scripts/patch-android.mjs",
    "android": "npm run sync && npx cap open android"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.2.1"
  },
  "dependencies": {
    "@aparajita/capacitor-biometric-auth": "^8.0.2",
    "@capacitor/android": "^6.2.1",
    "@capacitor/app": "^6.0.3",
    "@capacitor/core": "^6.2.1",
    "@capacitor/filesystem": "^6.0.4",
    "@capacitor/local-notifications": "^6.1.3",
    "@capacitor/share": "^6.0.4"
  }
}
